generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String
  password      String
  role          String          @default("user")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  refreshTokens RefreshToken[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  
  // MFA fields
  mfaEnabled      Boolean   @default(false)
  mfaSecret       String?   // Encrypted TOTP secret
  backupCodes     String?   // JSON array of hashed backup codes
  mfaRecoveryEmail String?  // Recovery email for MFA reset
  mfaLastVerifiedAt DateTime?
  mfaFailedAttempts Int      @default(0)
  mfaLockedUntil   DateTime?

  @@index([createdAt])
  @@index([email])
  @@index([role])
  @@index([email, role])
  @@index([deletedAt])
}


model RefreshToken {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime

  @@index([userId, expiresAt])
  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
}

model ApiKey {
  id            String   @id @default(cuid())
  keyHash       String   @unique
  name          String
  tier          String   @default("FREE") // FREE, PRO, ENTERPRISE
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  isActive      Boolean  @default(true)
  allowedIps    String   @default("") // JSON string array of allowed IP addresses
  allowedPaths  String   @default("") // JSON string array of allowed path patterns
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  expiresAt     DateTime?
  lastUsedAt    DateTime @default(now())
  usageQuota    Int?     // Monthly quota if applicable
  currentUsage  Int      @default(0)
  usageResetAt  DateTime @default(now())
  deletedAt     DateTime?

  // Relations
  usageLogs     ApiUsage[]

  @@map("api_keys")
  @@index([userId, isActive])
  @@index([expiresAt])
  @@index([lastUsedAt])
  @@index([tier])
  @@index([keyHash])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([userId, tier])
}

model ApiUsage {
  id           String   @id @default(cuid())
  apiKeyId     String
  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  endpoint     String
  method       String
  statusCode   Int
  responseTime Int      // in milliseconds
  requestSize  Int      // in bytes
  responseSize Int      // in bytes
  ip           String
  userAgent    String?
  timestamp    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@map("api_usage")
  @@index([apiKeyId, timestamp])
  @@index([endpoint, timestamp])
  @@index([statusCode, timestamp])
  @@index([ip, timestamp])
  @@index([timestamp])
  @@index([apiKeyId])
  @@index([method])
  @@index([responseTime])
  @@index([deletedAt])
  @@index([apiKeyId, statusCode])
}

// ---------------------------------------------------------------------------
// ML Model Registry & A/B Testing (MLOps)
// ---------------------------------------------------------------------------

model MLModel {
  id          String        @id @default(cuid())
  name        String        @unique
  description String        @default("")
  taskType    String        // e.g. "credit_scoring", "fraud_detection"
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  versions    MLModelVersion[]
  experiments Experiment[]

  @@map("ml_models")
  @@index([taskType])
}

model MLModelVersion {
  id                String    @id @default(cuid())
  modelId           String
  model             MLModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  version           String    // semantic version, e.g. "2.0.0"
  stage             String    @default("staging") // staging | production | archived
  artifactUri       String    // path/URI to .pkl / .joblib artifact
  contentHash       String    // SHA256 of the model artifact (content-addressable)
  frameworkVersion  String?   // e.g. scikit-learn==1.4.2
  accuracy          Float?
  precision         Float?
  recall            Float?
  f1Score           Float?
  auc               Float?
  trainingDataUri   String?
  trainingDataHash  String?
  hyperparameters   String    @default("{}") // JSON string
  metadata          String    @default("{}") // JSON string
  datasetVersion    String?
  codeCommit        String?   // git commit SHA of training code
  trainingRunId     String?   // link to external training run (e.g. MLflow run id)
  approvedBy        String?
  approvedAt        DateTime?
  promotedAt        DateTime?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  variants          ExperimentVariant[]
  driftChecks       ModelDriftCheck[]
  evaluations       ModelEvaluationReport[]
  promotionOverrides ModelPromotionOverride[]

  @@map("ml_model_versions")
  @@unique([modelId, version])
  @@index([modelId, stage])
  @@index([contentHash])
  @@index([stage])
}

model ModelEvaluationReport {
  id                String   @id @default(cuid())
  modelVersionId    String
  modelVersion      MLModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  schemaVersion     Int      @default(1)
  reportJson        String
  reportHash        String
  policyJson        String
  policyHash        String
  artifactHash      String
  datasetHash       String
  codeCommit        String
  passed            Boolean
  decision          String
  failureReasons    String   @default("[]")
  createdAt         DateTime @default(now())

  overrides         ModelPromotionOverride[]

  @@map("model_evaluation_reports")
  @@index([modelVersionId, createdAt])
  @@unique([modelVersionId, reportHash])
}

model ModelPromotionOverride {
  id                String   @id @default(cuid())
  modelVersionId    String
  modelVersion      MLModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)
  evaluationId      String
  evaluation        ModelEvaluationReport @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  actor             String
  authorizedRole    String
  reason            String
  createdAt         DateTime @default(now())

  @@map("model_promotion_overrides")
  @@index([modelVersionId])
}

model Experiment {
  id                  String    @id @default(cuid())
  key                 String    @unique
  name                String
  description         String    @default("")
  modelId             String
  model               MLModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  status              String    @default("draft") // draft | running | paused | completed | rolled_back
  hypothesis          String    @default("")
  metric              String    // primary conversion/success metric name
  minimumDetectableEffect Float?
  significanceLevel   Float     @default(0.05)
  power               Float     @default(0.8)
  bonferroniCorrection Boolean  @default(false)
  canaryThresholdPct  Float     @default(5.0) // auto-rollback if degradation exceeds this %
  canaryWindowHours   Int       @default(24)
  startedAt           DateTime?
  endedAt             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  variants            ExperimentVariant[]
  assignments         ExperimentAssignment[]
  events              ExperimentEvent[]

  @@map("experiments")
  @@index([modelId])
  @@index([status])
}

model ExperimentVariant {
  id            String     @id @default(cuid())
  experimentId  String
  experiment    Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  modelVersionId String
  modelVersion  MLModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  name          String     // e.g. "control", "treatment"
  isControl     Boolean    @default(false)
  trafficWeight Float      // 0-100, must sum to 100 across an experiment's variants
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  assignments   ExperimentAssignment[]
  events        ExperimentEvent[]

  @@map("experiment_variants")
  @@unique([experimentId, name])
  @@index([experimentId])
}

model ExperimentAssignment {
  id            String     @id @default(cuid())
  experimentId  String
  experiment    Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  subjectId     String     // user id, session id, or account id used for stickiness
  assignedAt    DateTime   @default(now())

  @@map("experiment_assignments")
  @@unique([experimentId, subjectId])
  @@index([experimentId, variantId])
  @@index([subjectId])
}

model ExperimentEvent {
  id            String     @id @default(cuid())
  experimentId  String
  experiment    Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  subjectId     String
  eventType     String     // "exposure" | "conversion" | "metric"
  metricName    String?
  metricValue   Float?
  createdAt     DateTime   @default(now())

  @@map("experiment_events")
  @@index([experimentId, variantId])
  @@index([experimentId, eventType])
  @@index([subjectId])
}

model ModelDriftCheck {
  id              String   @id @default(cuid())
  modelVersionId  String
  modelVersion    MLModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  windowStart     DateTime
  windowEnd       DateTime
  baselineAuc     Float
  observedAuc     Float
  aucDrop         Float    // percentage drop relative to baseline
  driftDetected   Boolean  @default(false)
  alertSent       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@map("model_drift_checks")
  @@index([modelVersionId])
  @@index([driftDetected])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String   // e.g. "USER_LOGIN", "DATA_ACCESS", "SETTINGS_UPDATE"
  resource      String?  // e.g. "user", "transaction", "report"
  resourceId    String?  // ID of the affected resource
  method        String?  // HTTP method: GET, POST, PUT, PATCH, DELETE
  endpoint      String?  // API endpoint path
  statusCode    Int?     // HTTP status code
  ipAddress     String?  // Client IP for geo-distribution
  userAgent     String?  // Client user agent
  requestData   String?  // JSON stringified (redacted)
  responseData  String?  // JSON stringified (redacted)
  errorMessage  String?  // Error details if failed
  duration      Int?     // Request duration in ms
  metadata      String?  // JSON for additional context (e.g. filter_criteria, PII_fields_accessed)
  piiRedacted   Boolean  @default(false) // Flag if PII was redacted
  createdAt     DateTime @default(now())
  archivedAt    DateTime? // When log was moved to cold storage
  deletedAt     DateTime? // Soft delete for GDPR right-to-be-forgotten

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([ipAddress])
  @@index([statusCode])
  @@index([archivedAt])
  @@index([userId, createdAt])
  @@index([action, statusCode])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Oracle Network Models
// ---------------------------------------------------------------------------

model OracleNode {
  id            String   @id @default(cuid())
  address       String   @unique // Stellar address
  publicKey     String   @unique // Stellar public key
  stake         BigInt   // Stake amount in stroops
  reputation    Int      @default(1000) // Starting reputation
  isActive      Boolean  @default(true)
  registeredAt  DateTime @default(now())
  unregisteredAt DateTime?
  metadata      String   @default("{}") // JSON for additional node info

  submissions   OracleSubmission[]
  slashEvents   SlashEvent[]
  reputationSnapshots ReputationSnapshot[]

  @@map("oracle_nodes")
  @@index([isActive])
  @@index([reputation])
  @@index([registeredAt])
}

model OracleSubmission {
  id            String   @id @default(cuid())
  requestId     String   // Unique request identifier from chain
  nodeId        String
  node          OracleNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  modelHash     String   // Hash of the model used
  commitHash    String   // Hash of (score, salt) for commit phase
  score         Int?     // Revealed score (null until reveal phase)
  salt          String?  // Salt for commit-reveal (null until reveal phase)
  phase         String   @default("commit") // commit, reveal, finalized
  committedAt   DateTime @default(now())
  revealedAt    DateTime?
  finalizedAt   DateTime?
  status        String   @default("pending") // pending, committed, revealed, finalized, slashed

  @@map("oracle_submissions")
  @@index([requestId])
  @@index([nodeId])
  @@index([phase])
  @@index([status])
  @@index([committedAt])
  @@unique([requestId, nodeId])
}

model Dispute {
  id            String   @id @default(cuid())
  requestId     String   // Request ID being disputed
  disputerAddress String  // Address of the disputer
  evidence      String   // JSON string of evidence
  status        String   @default("pending") // pending, accepted, rejected
  filedAt       DateTime @default(now())
  resolvedAt    DateTime?
  resolvedBy    String?  // Address that resolved the dispute
  resolutionNotes String?
  metadata      String   @default("{}") // JSON for additional dispute info

  @@map("disputes")
  @@index([requestId])
  @@index([disputerAddress])
  @@index([status])
  @@index([filedAt])
}

model SlashEvent {
  id            String   @id @default(cuid())
  nodeId        String
  node          OracleNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  requestId     String?  // Associated request ID (if applicable)
  slashAmount   BigInt   // Amount slashed in stroops
  reason        String   // Reason for slashing (e.g., "deviation", "no_reveal", "frivolous_dispute")
  slashedAt     DateTime @default(now())
  treasuryShare  BigInt   // Portion sent to treasury
  disputerShare String?  // Address of disputer (if applicable)
  disputerReward BigInt? // Portion sent to disputer

  @@map("slash_events")
  @@index([nodeId])
  @@index([requestId])
  @@index([slashedAt])
  @@index([reason])
}

model ReputationSnapshot {
  id            String   @id @default(cuid())
  nodeId        String
  node          OracleNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  reputation    Int
  delta         Int      // Change from previous snapshot
  reason        String?  // Reason for reputation change
  snapshotAt    DateTime @default(now())

  @@map("reputation_snapshots")
  @@index([nodeId])
  @@index([snapshotAt])
  @@unique([nodeId, snapshotAt])
}

