{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chenaikit.dev/schemas/ml-governance.schema.json",
  "title": "ChenAIKit Responsible Model Governance",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/localExplanation" },
    { "$ref": "#/$defs/counterfactualResponse" },
    { "$ref": "#/$defs/evaluationReport" },
    { "$ref": "#/$defs/modelCard" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "finiteNumber": {
      "type": "number"
    },
    "featureValue": {
      "type": ["number", "string", "boolean", "null"]
    },
    "featureVector": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/featureValue" }
    },
    "confidenceInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper",
        "confidenceLevel",
        "method",
        "samples",
        "seed"
      ],
      "properties": {
        "lower": { "$ref": "#/$defs/finiteNumber" },
        "upper": { "$ref": "#/$defs/finiteNumber" },
        "confidenceLevel": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "method": { "const": "bootstrap_percentile" },
        "samples": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer" }
      }
    },
    "featureContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature",
        "displayName",
        "contribution",
        "rank"
      ],
      "properties": {
        "feature": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "unit": { "type": "string" },
        "contribution": { "$ref": "#/$defs/finiteNumber" },
        "rank": { "type": "integer", "minimum": 1 }
      }
    },
    "localExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "versionId",
        "method",
        "task",
        "baseValue",
        "modelOutput",
        "contributions",
        "additivityError",
        "additivityPassed",
        "durationMs",
        "warnings"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "versionId": { "type": "string", "minLength": 1 },
        "method": {
          "enum": ["tree_shap", "model_agnostic_occlusion"]
        },
        "task": {
          "enum": ["binary_classification", "regression"]
        },
        "baseValue": { "$ref": "#/$defs/finiteNumber" },
        "modelOutput": { "$ref": "#/$defs/finiteNumber" },
        "contributions": {
          "type": "array",
          "items": { "$ref": "#/$defs/featureContribution" }
        },
        "additivityError": { "type": "number", "minimum": 0 },
        "additivityPassed": { "type": "boolean" },
        "durationMs": { "type": "number", "minimum": 0 },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "counterfactualCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "features",
        "changedFeatures",
        "modelOutput",
        "verified",
        "cost"
      ],
      "properties": {
        "features": { "$ref": "#/$defs/featureVector" },
        "changedFeatures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "modelOutput": { "$ref": "#/$defs/finiteNumber" },
        "verified": { "const": true },
        "cost": { "type": "number", "minimum": 0 }
      }
    },
    "counterfactualResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "versionId",
        "status",
        "candidates",
        "searchedCandidates",
        "durationMs",
        "warnings"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "versionId": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["feasible", "no_feasible_counterfactual"]
        },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/counterfactualCandidate" }
        },
        "searchedCandidates": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "number", "minimum": 0 },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "no_feasible_counterfactual" } }
          },
          "then": {
            "properties": { "candidates": { "maxItems": 0 } }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "feasible" } }
          },
          "then": {
            "properties": { "candidates": { "minItems": 1 } }
          }
        }
      ]
    },
    "promotionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "minimumDatasetRows",
        "minimumCohortSize",
        "requiredMetrics",
        "fairness",
        "explainability",
        "onFailure"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "minimumDatasetRows": { "type": "integer", "minimum": 1 },
        "minimumCohortSize": { "type": "integer", "minimum": 1 },
        "requiredMetrics": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(>=|<=|>|<|==)\\s*-?\\d+(\\.\\d+)?$"
          }
        },
        "fairness": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(>=|<=|>|<|==)\\s*-?\\d+(\\.\\d+)?$"
          }
        },
        "explainability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["additivityPassRate", "maxP95ExplanationMs"],
          "properties": {
            "additivityPassRate": {
              "type": "string",
              "pattern": "^(>=|<=|>|<|==)\\s*-?\\d+(\\.\\d+)?$"
            },
            "maxP95ExplanationMs": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "onFailure": { "enum": ["block", "warn"] }
      }
    },
    "evaluationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "modelArtifactHash",
        "datasetHash",
        "codeCommit",
        "datasetRows",
        "metrics",
        "fairness",
        "explainability",
        "policy"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "modelArtifactHash": { "$ref": "#/$defs/sha256" },
        "datasetHash": { "$ref": "#/$defs/sha256" },
        "codeCommit": {
          "type": "string",
          "minLength": 7,
          "maxLength": 64
        },
        "datasetRows": { "type": "integer", "minimum": 0 },
        "metrics": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/finiteNumber" }
        },
        "fairness": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "$ref": "#/$defs/finiteNumber" },
              {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string" }
              }
            ]
          }
        },
        "explainability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["additivityPassRate", "p95ExplanationMs"],
          "properties": {
            "additivityPassRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "p95ExplanationMs": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "policy": { "$ref": "#/$defs/promotionPolicy" },
        "modelCard": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "policyCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "actual", "threshold", "passed"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "actual": {
          "oneOf": [
            { "type": "number" },
            { "type": "array", "items": { "type": "string" } },
            { "type": "null" }
          ]
        },
        "threshold": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "reason": {
          "enum": [
            "metric_missing",
            "threshold_not_met",
            "suppressed_cohorts_cannot_pass"
          ]
        }
      }
    },
    "policyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "passed",
        "decision",
        "checks",
        "policyHash",
        "reportHash"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "passed": { "type": "boolean" },
        "decision": { "enum": ["pass", "warn", "block"] },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/policyCheck" }
        },
        "policyHash": { "$ref": "#/$defs/sha256" },
        "reportHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "promotionOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actor",
        "authorizedRole",
        "reason",
        "createdAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "authorizedRole": { "enum": ["admin", "ml_governance"] },
        "reason": { "type": "string", "minLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "modelCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "modelVersion",
        "artifactHash",
        "datasetHash",
        "datasetLineage",
        "codeCommit",
        "intendedUses",
        "prohibitedUses",
        "limitations",
        "explanationMethod",
        "explanationLimitations",
        "performance",
        "cohortPerformance",
        "policyResult",
        "approvedOverrides",
        "generatedAt",
        "notice"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "artifactHash": { "$ref": "#/$defs/sha256" },
        "datasetHash": { "$ref": "#/$defs/sha256" },
        "datasetLineage": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "codeCommit": {
          "type": "string",
          "minLength": 7,
          "maxLength": 64
        },
        "intendedUses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "prohibitedUses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "limitations": { "type": "string", "minLength": 1 },
        "explanationMethod": {
          "enum": ["tree_shap", "model_agnostic_occlusion"]
        },
        "explanationLimitations": { "type": "string", "minLength": 1 },
        "performance": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/finiteNumber" }
        },
        "cohortPerformance": {
          "type": "object",
          "additionalProperties": true
        },
        "policyResult": { "$ref": "#/$defs/policyResult" },
        "approvedOverrides": {
          "type": "array",
          "items": { "$ref": "#/$defs/promotionOverride" }
        },
        "generatedAt": { "type": "string", "format": "date-time" },
        "notice": { "type": "string", "minLength": 1 }
      }
    }
  }
}
